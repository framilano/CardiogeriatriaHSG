<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
        x:Class="SchedaVisite.Views.MainWindow"
        Title="Cardiogeriatria HSG"
        x:DataType="viewmodels:MainWindowViewModel"
        xmlns:views="clr-namespace:SchedaVisite.Views"
        xmlns:viewmodels="clr-namespace:SchedaVisite.ViewModels">
    
    <Window.DataTemplates>
        <DataTemplate DataType="{x:Type viewmodels:WelcomeUserControlViewModel}">
            <views:WelcomeUserControl/>
        </DataTemplate>

        <DataTemplate DataType="{x:Type viewmodels:VisitUserControlViewModel}">
            <views:VisitUserControl/>
        </DataTemplate>
    </Window.DataTemplates>

    <ContentControl Content="{Binding CurrentPage}" />
</Window>
