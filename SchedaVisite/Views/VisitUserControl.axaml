<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:viewModels="clr-namespace:SchedaVisite.ViewModels"
             xmlns:views="clr-namespace:SchedaVisite.Views"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:Class="SchedaVisite.Views.VisitUserControl"
             x:DataType="viewModels:VisitUserControlViewModel"
             FontSize="35">
    
    <Design.DataContext>
        <!-- This only sets the DataContext for the previewer in an IDE,
             to set the actual DataContext for runtime, set the DataContext property in code (look at App.axaml.cs) -->
        <viewModels:VisitUserControlViewModel/>
    </Design.DataContext>
    
    <Grid
        ColumnDefinitions="Auto, *, Auto"
        RowDefinitions="Auto, *, Auto">
        <views:HeaderUserControl Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="3"/>
        <views:SidebarUserControl Grid.Row="1" Grid.Column="0" />
        
        <Border BorderBrush="Black"
                BorderThickness="2"
                Grid.Row="1" Grid.Column="1">
            <TextBlock>COLONNA A</TextBlock>
        </Border>
        <Border BorderBrush="Black"
                BorderThickness="2"
                Grid.Row="1" Grid.Column="2">
            <TextBox>COLONNA B</TextBox>
        </Border>
        
        <views:FooterUserControl Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="3" />
    </Grid>
</UserControl>
