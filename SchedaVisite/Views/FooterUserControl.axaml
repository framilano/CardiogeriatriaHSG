<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:Class="SchedaVisite.Views.FooterUserControl">
    <Border  Background="Gray"
             BorderBrush="Black"
             BorderThickness="2">
        <SelectableTextBlock  Padding="10" VerticalAlignment="Bottom" HorizontalAlignment="Center">
            <Run Text="In caso di necessità contattare via mail" />
            <Run FontWeight="Bold" Text="cardiogeriatria@irccs-sangerardo.it"/>
        </SelectableTextBlock>
    </Border>
</UserControl>
