<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:visitContent="clr-namespace:SchedaVisite.ViewModels.VisitContent"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:Class="SchedaVisite.Views.VisitContent.RefertoUserControl"
             x:DataType="visitContent:RefertoUserControlViewModel"
             >
    <Border BorderBrush="Black"
            BorderThickness="2"
            >
        <TextBlock Padding="8" TextWrapping="Wrap" Name="ColumnDescription"></TextBlock>
    </Border>
</UserControl>
