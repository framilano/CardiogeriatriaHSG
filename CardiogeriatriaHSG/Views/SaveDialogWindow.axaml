<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
        x:Class="CardiogeriatriaHSG.Views.SaveDialogWindow"
        Title="SaveDialogWindow"
        Width="400"
        Height="200"
        CanResize="False"
        WindowStartupLocation="CenterOwner"
        SystemDecorations="BorderOnly">
    
    <Border BorderBrush="#6d1a61" BorderThickness="2" Padding="20">
        <WrapPanel ItemSpacing="10" Orientation="Vertical" VerticalAlignment="Center" HorizontalAlignment="Center">
            <TextBlock TextAlignment="Center" Name="Message" HorizontalAlignment="Center" TextWrapping="Wrap" />
            <Button Name="ConfirmButton" HorizontalAlignment="Center" Click="OnCloseClick" Content="OK"/>
        </WrapPanel>
    </Border>
</Window>
