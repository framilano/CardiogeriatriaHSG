<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:visitContent="clr-namespace:CardiogeriatriaHSG.ViewModels.VisitContent"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:Class="CardiogeriatriaHSG.Views.VisitContent.ConclusioniUserControl"
             x:DataType="visitContent:ConclusioniUserControlViewModel">
            <UserControl.Styles>
                <StyleInclude Source="/Styles/VisitUserControlStyle.axaml"/>
            </UserControl.Styles>
            <Border Classes="ColumnBorder">
                <TextBox Classes="NoColumnTextBox" Name="ManualColumnB" Text="{Binding CurrentVisitCo.CoText}" MaxLength="{x:Static visitContent:ConclusioniUserControlViewModel.MaxTextLength}"></TextBox>
            </Border>
</UserControl>
