<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:CardiogeriatriaHSG.ViewModels"
             xmlns:views="clr-namespace:CardiogeriatriaHSG.Views"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:Class="CardiogeriatriaHSG.Views.WelcomeUserControl"
             x:DataType="vm:WelcomeUserControlViewModel"
             Background="#6d1a61">

    <Design.DataContext>
        <!-- This only sets the DataContext for the previewer in an IDE,
             to set the actual DataContext for runtime, set the DataContext property in code (look at App.axaml.cs) -->
        <vm:WelcomeUserControlViewModel />
    </Design.DataContext>
    
    <Grid RowDefinitions="Auto, *" ColumnDefinitions="*">
        <StackPanel Grid.Row="0" VerticalAlignment="Top" HorizontalAlignment="Center">
            <TextBlock Margin="15" HorizontalAlignment="Center" Text="Inserire codice paziente" FontWeight="Bold" />

            <TextBox MaxLength="16" TextAlignment="Center" Margin="5" HorizontalAlignment="Center"
                     Text="{Binding UserCodeTextBox, UpdateSourceTrigger=PropertyChanged}" Width="300" />

            <!-- <TextBlock Margin="5" Background="Black" HorizontalAlignment="Center" Foreground="Red"
                       Text="{Binding ErrorMessage}" /> -->

            <Button Margin="5" IsVisible="{Binding CreateVisitBtnVisibility}"
                    Background="DodgerBlue" HorizontalAlignment="Center" Content="Crea Nuova Visita"
                    Command="{Binding CreateNewVisit}" />

            <ScrollViewer IsVisible="{Binding LastVisitsListVisibility}" VerticalScrollBarVisibility="Auto">
                <ItemsControl BorderThickness="5" Background="Transparent" ItemsSource="{Binding LastVisitsList}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Button Margin="5"
                                    HorizontalAlignment="Center"
                                    Content="{Binding Timestamp, StringFormat='\{0:dd/MM/yyyy HH:mm}', Mode=OneWay}"
                                    Command="{Binding $parent[views:WelcomeUserControl].((vm:WelcomeUserControlViewModel)DataContext).LoadExistingVisitCommand}"
                                    CommandParameter="{Binding}" />
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>

        </StackPanel>
        <TextBlock VerticalAlignment="Bottom" HorizontalAlignment="Right" Grid.Row="1" Margin="10,10,10,10" FontSize="10" Opacity="0.5" Text="{Binding AppVersion}"></TextBlock>
    </Grid>
</UserControl>