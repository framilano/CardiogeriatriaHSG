<Styles xmlns="https://github.com/avaloniaui">
    <Style Selector="Button">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Padding" Value="0"/>
    </Style>
    
    <!-- NotSelectedMenuButton -->
    <Style Selector="Button.NotSelectedMenuButton">
        <Setter Property="Margin" Value="0"/>
        <Setter Property="Padding" Value="10"/>
        <Setter Property="BorderThickness" Value="0,0,0,2"/>
        <Setter Property="BorderBrush" Value="#6d1a61"/>
        <Setter Property="CornerRadius" Value="0"/>
        <Setter Property="HorizontalAlignment" Value="Stretch"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="FontWeight" Value="Bold"/>
    </Style>
    <Style Selector="Button.NotSelectedMenuButton:pointerover /template/ ContentPresenter">
        <Setter Property="Margin" Value="0"/>
        <Setter Property="Padding" Value="10"/>
        <Setter Property="BorderThickness" Value="0,0,0,2"/>
        <Setter Property="BorderBrush" Value="#6d1a61"/>
        <Setter Property="CornerRadius" Value="0"/>
        <Setter Property="Background" Value="#bd4089"/>
    </Style>
    
    <!-- SelectedMenuButton -->
    <Style Selector="Button.SelectedMenuButton">
        <Setter Property="Margin" Value="0"/>
        <Setter Property="Padding" Value="10"/>
        <Setter Property="BorderThickness" Value="0,0,0,2"/>
        <Setter Property="BorderBrush" Value="#6d1a61"/>
        <Setter Property="CornerRadius" Value="0"/>
        <Setter Property="HorizontalAlignment" Value="Stretch"/>
        <Setter Property="Background" Value="#6d1a61"/>
        <Setter Property="FontWeight" Value="Bold"/>
    </Style>
    <Style Selector="Button.SelectedMenuButton:pointerover /template/ ContentPresenter">
        <Setter Property="Margin" Value="0"/>
        <Setter Property="Padding" Value="10"/>
        <Setter Property="BorderThickness" Value="0,0,0,2"/>
        <Setter Property="BorderBrush" Value="#6d1a61"/>
        <Setter Property="CornerRadius" Value="0"/>
        <Setter Property="Background" Value="#6d1a61"/>
    </Style>
</Styles>