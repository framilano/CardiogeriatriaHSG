<Styles xmlns="https://github.com/avaloniaui">
    <Style Selector="Button">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Padding" Value="0"/>
    </Style>
    
    <Style Selector="TextBlock.GenericFieldLabel">
        <Setter Property="FontWeight" Value="Bold"/>
        <Setter Property="Padding" Value="10"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="TextWrapping" Value="Wrap"/>
    </Style>
    
    <Style Selector="WrapPanel.ColumnAWrapPanel">
        <Setter Property="Orientation" Value="Vertical"/>
        <Setter Property="ItemSpacing" Value="8"/>
    </Style>
    
    <Style Selector="Border.ColumnBorder">
        <Setter Property="BorderBrush" Value="#6d1a61"/>
        <Setter Property="BorderThickness" Value="2"/>
    </Style>
    
    <Style Selector="TextBox.ColumnBTextBox">
        <Setter Property="TextWrapping" Value="Wrap"/>
        <Setter Property="AcceptsReturn" Value="True"/>
        <Setter Property="Padding" Value="10 10 60 10"/>
        <Setter Property="MaxLength" Value="3000"/>
    </Style>
    
    <Style Selector="TextBlock.ColumnBTextBlock">
        <Setter Property="TextWrapping" Value="Wrap"/>
        <Setter Property="Padding" Value="10"/>
    </Style>
    
    <Style Selector="SelectableTextBlock.ColumnBSelectableTextBlock">
        <Setter Property="TextWrapping" Value="Wrap"/>
        <Setter Property="Padding" Value="10"/>
    </Style>
    
    <Style Selector="TextBox.TransparentButton">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
    </Style>
</Styles>